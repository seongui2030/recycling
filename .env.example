# ---------- Browser-safe values ----------
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# true이면 Roboflow 없이 수업용 데모 검출 결과를 사용합니다.
VITE_DEMO_MODE=true

# ---------- Vercel Server Environment Variables ----------
# 아래 값들은 브라우저 코드에 넣지 말고 Vercel Project Settings > Environment Variables에 넣으세요.
ROBOFLOW_API_KEY=
ROBOFLOW_MODEL_ID=recycling-items/1
